{
  "name": "storm-shelter",
  "productName": "StormShelter",
  "version": "0.1.0",
  "description": "A physics-based shelter building puzzle game for young children (ages 3+). Build a house that survives the storm!",
  "main": "main.js",
  "homepage": "https://shoukugames.org/",
  "author": {
    "name": "Shawn Rapaz",
    "email": "info@shoukugames.org",
    "url": "https://shoukugames.org/"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor.js",
    "test:sim": "node scripts/sim-test.js",
    "dist:linux": "electron-builder --linux deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist": "electron-builder --linux deb --win nsis portable"
  },
  "build": {
    "appId": "org.shoukugames.stormshelter",
    "productName": "StormShelter",
    "copyright": "Copyright (C) 2026 Shawn Rapaz - GPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "LICENSE",
      "package.json"
    ],
    "extraResources": [
      "README.md",
      "CHANGELOG.md",
      "BUGREPORT.md",
      "LICENSE"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Game",
      "icon": "resources/icons",
      "synopsis": "Physics shelter-building puzzle game for kids 3+",
      "maintainer": "Shawn Rapaz <info@shoukugames.org>",
      "vendor": "Shouku Games",
      "executableName": "stormshelter"
    },
    "deb": {
      "packageCategory": "games"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "StormShelter-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "StormShelter-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "planck": "^1.5.1"
  }
}
